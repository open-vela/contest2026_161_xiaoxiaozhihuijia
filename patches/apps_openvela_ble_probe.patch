+static int probe_monotonic_ms(uint64_t *now_ms)
+{
+  uint64_t now_us;
+
+  if (probe_get_monotonic_us(&now_us) < 0)
+    {
+      return -1;
+    }
+
+  *now_ms = now_us / 1000ULL;
+  return 0;
