+#include <stdbool.h>
+#include <stdint.h>
+
+enum probe_judgement_e
+{
+  PROBE_JUDGEMENT_READY = 0,
+  PROBE_JUDGEMENT_PERFECT,
+  PROBE_JUDGEMENT_GOOD,
+  PROBE_JUDGEMENT_MISS
+};
