From 7f222a5a22e2628ba6844e242ef95c6244785db1 Mon Sep 17 00:00:00 2001
From: yangshuxuan <yangshuxuan1024@gmail.com>
Date: Sun, 30 Aug 2026 16:45:22 +0800
Subject: [PATCH 1/2] fix(sf32lb52): protect Bluetooth IPC shared memory

---
 chips/sf32lb52/sifli_allocateheap.c |  5 +++--
 chips/sf32lb52/sifli_start.c        | 34 +++++++++++++++++++++++++++++
 2 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/chips/sf32lb52/sifli_allocateheap.c b/chips/sf32lb52/sifli_allocateheap.c
index 62371c5..1f5e584 100644
--- a/chips/sf32lb52/sifli_allocateheap.c
+++ b/chips/sf32lb52/sifli_allocateheap.c
@@ -31,6 +31,7 @@
 #include "chip.h"
 #include "arm_internal.h"
 #include "bf0_hal.h"
+#include "mem_map.h"
 
 extern void BSP_PIN_Init(void);
 extern void BSP_Power_Up(bool is_deep_sleep);
@@ -160,10 +161,10 @@ void HAL_PreInit(void)
 
 void up_allocate_heap(FAR void **heap_start, size_t *heap_size)
 {
-  /* The heap starts at g_idle_topstack and extends to the end of SRAM */
+  /* Reserve the HCPU-to-LCPU Bluetooth mailbox at the end of SRAM. */
   
   *heap_start = (FAR void *)g_idle_topstack;
-  *heap_size  = SRAM_END - g_idle_topstack;
+  *heap_size  = HCPU2LCPU_MB_CH1_BUF_START_ADDR - g_idle_topstack;
 }
 
 /******************************************************************************
diff --git a/chips/sf32lb52/sifli_start.c b/chips/sf32lb52/sifli_start.c
index 1ee5c85..e329004 100644
--- a/chips/sf32lb52/sifli_start.c
+++ b/chips/sf32lb52/sifli_start.c
@@ -49,6 +49,13 @@
 
 #define HEAP_BASE      ((uintptr_t)_ebss + CONFIG_IDLETHREAD_STACKSIZE)
 
+#define SIFLI_LPSYS_RAM_BASE  0x203fc000
+#define SIFLI_LPSYS_RAM_LIMIT 0x204fffff
+#define SIFLI_MPU_ATTR_RAM_IDX 0
+#define SIFLI_MPU_ATTR_RAM \
+  ARM_MPU_ATTR(ARM_MPU_ATTR_NON_CACHEABLE, \
+               ARM_MPU_ATTR_NON_CACHEABLE)
+
 extern uint32_t _siramfunc;
 extern uint32_t _sramfunc;
 extern uint32_t _eramfunc;
@@ -141,6 +148,26 @@ const uintptr_t g_idle_topstack = HEAP_BASE;
  * Private Functions
  ****************************************************************************/
 
+static void sifli_lpsys_mpu_config(void)
+{
+  uint32_t region;
+
+  ARM_MPU_Disable();
+
+  for (region = 0; region < MPU_REGION_NUM; region++)
+    {
+      ARM_MPU_ClrRegion(region);
+    }
+
+  ARM_MPU_SetMemAttr(SIFLI_MPU_ATTR_RAM_IDX, SIFLI_MPU_ATTR_RAM);
+  ARM_MPU_SetRegion(
+    0,
+    ARM_MPU_RBAR(SIFLI_LPSYS_RAM_BASE, ARM_MPU_SH_NON, 0, 1, 0),
+    ARM_MPU_RLAR(SIFLI_LPSYS_RAM_LIMIT, SIFLI_MPU_ATTR_RAM_IDX));
+
+  ARM_MPU_Enable(MPU_CTRL_HFNMIENA_Msk | MPU_CTRL_PRIVDEFENA_Msk);
+}
+
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
@@ -196,6 +223,13 @@ void __start(void)
 
   arm_lowputc('A'); /* data segment init done */
 
+  /* The SiFli IPC rings are shared with LCPU and have producer and consumer
+   * indices in the same cache line.  Establish their non-cacheable memory
+   * attribute before either cache is enabled.
+   */
+
+  sifli_lpsys_mpu_config();
+
 #ifdef CONFIG_ARMV8M_ICACHE
   up_enable_icache();
 #endif

