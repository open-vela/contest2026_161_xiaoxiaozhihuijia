From 44ef43643cf8e9e46b1ccb55aa0aaa3198641bbe Mon Sep 17 00:00:00 2001
From: yangshuxuan1024 <yangshuxuan1024@gmail.com>
Date: Fri, 18 Sep 2026 22:17:26 +0800
Subject: [PATCH] wireless: define HCI RX ring diagnostic snapshot

Signed-off-by: yangshuxuan1024 <yangshuxuan1024@gmail.com>
---
 .../wireless/bluetooth/bt_hci_rx_snapshot.h   | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)
 create mode 100644 include/nuttx/wireless/bluetooth/bt_hci_rx_snapshot.h

diff --git a/include/nuttx/wireless/bluetooth/bt_hci_rx_snapshot.h b/include/nuttx/wireless/bluetooth/bt_hci_rx_snapshot.h
new file mode 100644
index 0000000..6a846e1
--- /dev/null
+++ b/include/nuttx/wireless/bluetooth/bt_hci_rx_snapshot.h
@@ -0,0 +1,32 @@
+/****************************************************************************
+ * include/nuttx/wireless/bluetooth/bt_hci_rx_snapshot.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#ifndef __INCLUDE_NUTTX_WIRELESS_BLUETOOTH_BT_HCI_RX_SNAPSHOT_H
+#define __INCLUDE_NUTTX_WIRELESS_BLUETOOTH_BT_HCI_RX_SNAPSHOT_H
+
+#include <stdint.h>
+
+struct bt_hci_rx_ring_snapshot_s
+{
+  uint32_t ring_read_mirror;
+  uint32_t ring_write_mirror;
+  uint32_t local_read_mirror;
+  uint32_t mailbox_count;
+  uint32_t worker_count;
+  uint32_t drain_count;
+  uint32_t copied_bytes;
+  uint32_t callback_count;
+  uint32_t complete_h4_count;
+  uint32_t forwarded_h4_count;
+  uint32_t sequence;
+  uint16_t last_opcode;
+  uint8_t last_h4_type;
+  uint8_t last_event;
+};
+
+int bt_hci_rx_ring_snapshot(struct bt_hci_rx_ring_snapshot_s *snapshot);
+
+#endif
-- 
