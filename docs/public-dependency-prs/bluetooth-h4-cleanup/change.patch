From 238c974d78a969122b0dc361a3d85771c6cd95a7 Mon Sep 17 00:00:00 2001
From: yangshuxuan1024 <284936491+yangshuxuan1024@users.noreply.github.com>
Date: Fri, 18 Sep 2026 21:50:25 +0800
Subject: [PATCH] bluetooth: close H4 transport and propagate cleanup results

Signed-off-by: yangshuxuan1024 <284936491+yangshuxuan1024@users.noreply.github.com>
---
 framework/api/bluetooth.c                     | 37 +++++++-
 service/common/service_loop.c                 | 36 ++++++++
 service/common/service_trace.h                |  9 ++
 service/src/adapter_service.c                 |  5 ++
 .../stacks/include/sal_adapter_le_interface.h |  2 +
 service/stacks/zephyr/hci_h4.c                | 90 ++++++++++++++++++-
 .../stacks/zephyr/sal_adapter_le_interface.c  | 58 +++++++++++-
 service/stacks/zephyr/sal_gatt_db_ownership.h | 29 ++++++
 .../stacks/zephyr/sal_gatt_server_interface.c | 36 ++++++--
 .../zephyr/sal_le_advertise_interface.c       | 37 ++++++--
 10 files changed, 317 insertions(+), 22 deletions(-)
 create mode 100644 service/common/service_trace.h
