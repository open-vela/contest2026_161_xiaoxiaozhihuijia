From 75b9ccf4077439b6f4b2b9a8dc9bfc298c86c8ec Mon Sep 17 00:00:00 2001
From: yangshuxuan1024 <284936491+yangshuxuan1024@users.noreply.github.com>
Date: Fri, 18 Sep 2026 21:50:23 +0800
Subject: [PATCH] fix(nuttx): release owned LCD pixel buffers

Signed-off-by: yangshuxuan1024 <284936491+yangshuxuan1024@users.noreply.github.com>
---
 src/drivers/nuttx/lv_nuttx_lcd.c | 25 ++++++++++++++++++-------
 1 file changed, 18 insertions(+), 7 deletions(-)

diff --git a/src/drivers/nuttx/lv_nuttx_lcd.c b/src/drivers/nuttx/lv_nuttx_lcd.c
index a53f4b8f2..e8e8df77e 100644
--- a/src/drivers/nuttx/lv_nuttx_lcd.c
+++ b/src/drivers/nuttx/lv_nuttx_lcd.c
@@ -37,6 +37,8 @@ typedef struct {
     /* fd should be defined at the beginning */
     int fd;
     lv_display_t * disp;
+    void * draw_buf;
+    void * draw_buf_2;
     struct lcddev_area_s area;
     struct lcddev_area_align_s align_info;
 } lv_nuttx_lcd_t;
@@ -177,6 +179,7 @@ static lv_display_t * lcd_init(int fd, int hor_res, int ver_res)
     draw_buf = lv_malloc(buf_size);
     if(draw_buf == NULL) {
         LV_LOG_ERROR("display draw_buf malloc failed");
+        lv_display_delete(disp);
         lv_free(lcd);
         return NULL;
     }
@@ -185,6 +188,7 @@ static lv_display_t * lcd_init(int fd, int hor_res, int ver_res)
     draw_buf_2 = lv_malloc(buf_size);
     if(draw_buf_2 == NULL) {
         LV_LOG_ERROR("display draw_buf_2 malloc failed");
+        lv_display_delete(disp);
         lv_free(lcd);
         lv_free(draw_buf);
         return NULL;
@@ -192,6 +196,8 @@ static lv_display_t * lcd_init(int fd, int hor_res, int ver_res)
 #endif
 
     lcd->fd = fd;
+    lcd->draw_buf = draw_buf;
+    lcd->draw_buf_2 = draw_buf_2;
     if(ioctl(fd, LCDDEVIO_GETAREAALIGN, &lcd->align_info) < 0) {
         perror("Error: ioctl(LCDDEVIO_GETAREAALIGN) failed");
     }
@@ -214,14 +220,19 @@ static void display_release_cb(lv_event_t * e)
         lv_display_set_driver_data(disp, NULL);
         lv_display_set_flush_cb(disp, NULL);
 
-        /* clear display buffer */
-        if(disp->buf_1) {
-            lv_free(disp->buf_1);
-            disp->buf_1 = NULL;
+        /* lv_display_set_buffers() wraps the raw allocations in the
+         * lv_display_t embedded _static_buf objects.  disp->buf_1/buf_2
+         * therefore point at descriptors, not at the allocated pixel
+         * buffers.  The NuttX LCD context owns and releases the exact raw
+         * pointers returned by lv_malloc().
+         */
+        if(dsc->draw_buf) {
+            lv_free(dsc->draw_buf);
+            dsc->draw_buf = NULL;
         }
-        if(disp->buf_2) {
-            lv_free(disp->buf_2);
-            disp->buf_2 = NULL;
+        if(dsc->draw_buf_2) {
+            lv_free(dsc->draw_buf_2);
+            dsc->draw_buf_2 = NULL;
         }
 
         /* close device fb */
-- 
2.34.1

